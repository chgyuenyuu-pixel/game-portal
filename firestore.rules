rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid}/games/{game} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 存檔碼：知道碼先讀到（禁止 list）；只有擁有者寫
    match /codes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && code.size() >= 6 && code.size() <= 8;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      match /games/{game} {
        allow get, list: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(db)/documents/codes/$(code)).data.uid == request.auth.uid;
      }
    }

    // ===============================================================
    // Assumed Data Model — public portal counters (unauth OK by design)
    // Collection: portal_stats / Document: main
    //   - views: int (>=0) — total page loads
    //   - visitors: int (>=0) — unique browsers (localStorage)
    //   - updatedAt: timestamp
    // Collection: portal_online / Document: {sessionId 8-64 chars}
    //   - lastSeen: timestamp
    //   - ua: string (optional)
    // ===============================================================

    function portalStatsValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['views', 'visitors', 'updatedAt'])
        && d.views is int && d.visitors is int
        && d.views >= 0 && d.visitors >= 0
        && d.updatedAt is timestamp;
    }

    match /portal_stats/main {
      allow read: if true;
      allow create: if portalStatsValid()
        && request.resource.data.views <= 1
        && request.resource.data.visitors <= 1;
      allow update: if portalStatsValid()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['views', 'visitors', 'updatedAt'])
        && request.resource.data.views >= resource.data.views
        && request.resource.data.views <= resource.data.views + 1
        && request.resource.data.visitors >= resource.data.visitors
        && request.resource.data.visitors <= resource.data.visitors + 1;
      allow delete: if false;
    }

    match /portal_online/{id} {
      allow read: if true;
      allow create, update: if id.size() >= 8 && id.size() <= 64
        && request.resource.data.lastSeen is timestamp
        && (request.resource.data.keys().hasOnly(['lastSeen'])
            || (request.resource.data.keys().hasOnly(['lastSeen', 'ua'])
                && request.resource.data.ua is string
                && request.resource.data.ua.size() <= 200));
      allow delete: if id.size() >= 8 && id.size() <= 64;
    }
  }
}
